# ============================================================
# DRIVE-META-PUBLISHER - Variables de Entorno (Plantilla Coolify)
# ============================================================

PORT=3050

# URL pública con la que accederás desde Internet (ej: https://publisher.tudominio.com o http://IP_DEL_VPS:3050)
PUBLIC_SERVER_URL=https://publisher.tudominio.com

# ------------------------------------------------------------
# 0. SEGURIDAD DEL DASHBOARD (Autenticación Web en Coolify)
# ------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASS=admin2s1m2026

# ------------------------------------------------------------
# 1. META GRAPH API (2S1M Rent Car: Facebook e Instagram)
# ------------------------------------------------------------
FACEBOOK_PAGE_ID=1106475979223593
FACEBOOK_PAGE_ACCESS_TOKEN=tu_token_de_meta_aqui
# Opcional si quieres especificar el ID directo de Instagram
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------
# 2. GOOGLE OAUTH2 (Conexión directa con Google Drive)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=https://publisher.tudominio.com/auth/callback

# ------------------------------------------------------------
# 3. GOOGLE DRIVE (Ajustes de búsqueda de posts)
# ------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=root
ARCHIVE_FOLDER_NAME=Publicados

# ------------------------------------------------------------
# 4. PROGRAMACIÓN AUTOMÁTICA (4 Franjas Horarias al Día)
# ------------------------------------------------------------
# Publica a las 10:00, 14:00, 18:00 y 21:00 (Casablanca / Marruecos)
CRON_SCHEDULE=0 10,14,18,21 * * *
TIMEZONE=Africa/Casablanca

# Publicar también Stories en cada franja horaria usando la misma foto
PUBLISH_STORIES=true
